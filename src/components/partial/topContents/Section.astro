---
import { Image } from "astro:assets";
import TransitionLink from "../../UIcontent/transitionOption/TransitionLink.astro";
const {
  color,
  height,
  rounded = true,
  headImage,
  footImage,
  link,
  isTop = false,
} = Astro.props;
// import TransitionLink from "../components/transitionOption/TransitionLink.astro";
---

<div class:list={["area", { rounded: rounded, "not-top": !isTop }]}>
  <slot name="background" />
  {
    headImage && (
      <div class="head_container">
        <Image class="head_image" src={headImage} alt="" />
      </div>
    )
  }

  <slot />

  {
    footImage && (
      <div class="foot_container">
        <TransitionLink
          href={link}
          transition="slide"
          class="section-link"
          data-from-top="true"
        >
          <Image class="foot_image" src={footImage} alt="" />
        </TransitionLink>
      </div>
    )
  }
</div>

<style define:vars={{ color, height }}>
  .area {
    height: 100vh;
    min-height: var(--height);
    background-color: var(--color);
    scroll-snap-align: start;
    position: relative;
  }

  .not-top {
    padding: 0 50px;
  }
  @media screen and (max-width: 839px) {
    .not-top {
      padding: 0;
    }
  }

  .rounded {
    display: flex;
    justify-content: space-around;
    flex-direction: column;
  }

  @media screen and (max-width: 839px) {
    .rounded {
      padding: 20px 0;
    }
  }

  .head_container {
    display: flex;
    justify-content: center;
    position: relative;
    z-index: 1;
  }

  .foot_container {
    display: flex;
    justify-content: right;
    position: relative;
    z-index: 1;
  }

  .head_image {
    width: 200px;
    height: auto;
  }
  .foot_image {
    width: 200px;
    height: auto;
    transition: transform 0.3s ease;
  }

  /* ホバーエフェクト追加 */
  .section-link:hover .foot_image {
    transform: scale(1.05);
  }

  @media screen and (max-width: 839px) {
    .foot_container {
      margin-bottom: 40px;
    }
  }

  .foot_image {
    width: 170px;
    height: auto;
    transition: transform 0.3s ease;
  }
</style>

<script>
  // セクションリンクのトラッキング
  document.addEventListener("astro:page-load", () => {
    const sectionLinks = document.querySelectorAll(".section-link");

    sectionLinks.forEach((link) => {
      link.addEventListener("click", (e) => {
        console.log(
          "Section link clicked: ",
          (e.currentTarget as HTMLAnchorElement).href,
        );
        // TOPページからの遷移を記録
        sessionStorage.setItem("cameFromTop", "true");
        sessionStorage.setItem(
          "lastClickedSection",
          (e.currentTarget as HTMLAnchorElement).href,
        );
      });
    });
  });
</script>
