---
import Menu from "./Menu.astro";
import { Loading } from "../../UIcontent/loading/Loading.tsx";
import { Image } from "astro:assets";
import mainImage from "../../../img/main_image.jpg";
---

<div class="wrapper">
  <!-- <Loading client:load /> -->
  <Image class="main_image" src={mainImage} alt="" />
  <div class="menu_area">
    <Menu />
  </div>
</div>

<style>
  .main_image {
    width: 60%;
    height: auto;
  }

  @media screen and (min-width: 720px) and (max-width: 890px) {
    .main_image {
      width: 100%;
      height: 100dvh;
      object-fit: cover;
    }
    .menu_area {
      display: none;
    }
  }

  @media screen and (max-width: 719px) {
    .main_image {
      width: auto;
      height: 100dvh;
      object-fit: cover;
    }

    .menu_area {
      display: none;
    }
  }

  .wrapper {
    position: relative;
    overflow: hidden;
    height: 100dvh;
    background-color: #1d2027;
  }

  .menu_area {
    position: absolute;
    z-index: 10;
    top: 10dvh;
    right: 3vw;
    width: 30%;
  }
</style>
