---
import { Image } from "astro:assets";
import accentTop from "../../../img/menu/02.png";
import accentBottom from "../../../img/menu/01.png";
import FontAwesomeIcon from "../../../layouts/FontAwesomeIcon.astro";
import { faSquareBluesky } from "@fortawesome/free-brands-svg-icons";
import { faSquareXTwitter } from "@fortawesome/free-brands-svg-icons";
import { faInstagram } from "@fortawesome/free-brands-svg-icons";
---

<div class="menu_wrapper">
  <div class="title_text">tabi :)<br />Illustration</div>
  <div class="menu_list">
    <ul>
      <li class="menu_title">
        <a href="#info-section" class="menu-link">Info</a>
      </li>
      <li class="menu_title">
        <a href="#illust-section" class="menu-link">Illust</a>
      </li>
      <li class="menu_title">
        <a href="#work-section" class="menu-link">Work</a>
      </li>
      <li class="menu_title">
        <a href="#profile-section" class="menu-link">Profile</a>
      </li>
      <li class="menu_title">
        <a href="#contact-section" class="menu-link">Contact</a>
      </li>
      <li class="menu_title">
        <a
          href="https://xfolio.jp/"
          target="_blank"
          rel="noopener noreferrer"
          class="menu-link"
          >Xfolio<i class="fa-solid fa-arrow-up-right-from-square"></i></a
        >
      </li>
    </ul>
    <Image src={accentTop} class="accent-top" alt="" />
    <Image src={accentBottom} class="accent-bottom" alt="" />
  </div>
  <div class="social-items">
    <a class="social-icon" href="https://x.com/tabi_0v0" target="_blank"
      ><FontAwesomeIcon icon={faSquareXTwitter} /></a
    >
    <a
      class="social-icon"
      href="https://www.instagram.com/tabi_0v0/"
      target="_blank"><FontAwesomeIcon icon={faInstagram} /></a
    >
    <a
      class="social-icon"
      href="https://bsky.app/profile/tabi-0v0.bsky.social"
      target="_blank"><FontAwesomeIcon icon={faSquareBluesky} /></a
    >
  </div>
</div>

<style>
  .fa-arrow-up-right-from-square {
    font-size: 15px;
    margin-left: 5px;
    position: relative;
    bottom: 2px;
    color: #ff896d;
  }
  .menu_wrapper {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }

  .title_text {
    font-family: "Playwrite NZ", serif;
    font-weight: 200;
    font-style: normal;
    font-size: min(5dvw, 6dvh, 45px);
    letter-spacing: 0px;
    line-height: min(5dvw, 6dvh, 50px);
    width: 100%;
    text-align: center;
    /* margin: 10px 20px; */
    color: white;
  }

  .menu_list {
    position: relative;
    margin-top: 10dvh;
    width: 17vw;
    background-color: #ededed;
    padding: 44px 0;
    border-radius: 20px;
  }
  .menu_title {
    font-family: "Rowdies Regular", serif;
    font-weight: 400;
    font-style: normal;
    font-size: min(2.5vw, 25px);
    letter-spacing: 0.1vw;
    color: #1d2027;
    text-align: center;
    line-height: min(3.5vw, 30px);
    padding: 5px 0px;
  }

  .menu_title:hover {
    background-color: #5fd3c6;
    color: #ffffff;
  }

  /* .menu_title.active {
    background-color: #5fd3c6;
    color: #ffffff;
  } */

  .menu-link {
    display: block;
    width: 100%;
    height: 100%;
    text-decoration: none;
    color: inherit;
  }

  .accent-top {
    position: absolute;
    top: 0px;
    left: -90px;
    width: 12vw;
    min-width: 170px;
    height: auto;
  }
  .accent-bottom {
    position: absolute;
    bottom: -20px;
    right: -75px;
    width: 10vw;
    min-width: 140px;
    height: auto;
  }

  .social-icon {
    font-size: 40px;
    color: #5fd3c6;
  }

  .social-icon:hover {
    opacity: 0.5;
  }

  @media screen and (max-height: 679px) {
    .menu_list {
      margin-top: 4dvh;
    }
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    // セクションへのスクロール機能
    const menuLinks = document.querySelectorAll(".menu-link");

    menuLinks.forEach((link) => {
      // 外部リンク（Xfolio）の場合はスキップ
      if (link.getAttribute("target") === "_blank") {
        return;
      }

      link.addEventListener("click", (e) => {
        e.preventDefault();

        const targetId = link.getAttribute("href");
        if (!targetId || !targetId.startsWith("#")) return;

        const targetElement = document.querySelector(targetId);
        if (!targetElement) return;

        // スムーズにスクロール
        targetElement.scrollIntoView({
          behavior: "smooth",
        });

        // メニュー項目をハイライト
        document.querySelectorAll(".menu_title").forEach((item) => {
          item.classList.remove("active");
        });
        (link.closest(".menu_title") as HTMLElement).classList.add("active");
      });
    });
  });
</script>
