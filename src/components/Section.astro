---
import { Image } from "astro:assets";
const { color, rounded = true, headImage, footImage } = Astro.props;
---

<div class:list={["area", { rounded: rounded }]}>
  {headImage && <Image class="head_image" src={headImage} alt="" />}

  <slot />

  {footImage && <Image class="foot_image" src={footImage} alt="" />}
</div>

<style define:vars={{ color }}>
  .area {
    height: 100vh;
    background-color: var(--color);
    scroll-snap-align: start;
  }

  .rounded {
    display: flex;
    align-items: center;
    flex-flow: column;
  }

  .head_image {
    width: 200px;
    height: auto;
  }
  .foot_image {
    width: 200px;
    height: auto;
  }
</style>
