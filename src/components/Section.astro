---
import { Image } from "astro:assets";
const { color, height, rounded = true, headImage, footImage } = Astro.props;
// import TransitionLink from "../components/transitionOption/TransitionLink.astro";
---

<div class:list={["area", { rounded: rounded }]}>
  {
    headImage && (
      <div class="head_container">
        <Image class="head_image" src={headImage} alt="" />
      </div>
    )
  }

  <slot />

  {
    footImage && (
      <div class="foot_container">
        {/* <TransitionLink href="/gallery" transition="slide">
          <Image class="foot_image" src={footImage} alt="" />
        </TransitionLink> */}

        <a href="/gallery">
          <Image class="foot_image" src={footImage} alt="" />
        </a>
      </div>
    )
  }
</div>

<style define:vars={{ color, height }}>
  .area {
    height: 100vh;
    min-height: var(--height);
    background-color: var(--color);
    scroll-snap-align: start;
  }

  .rounded {
    display: flex;
    justify-content: space-around;
    flex-direction: column;
  }

  .head_container {
    display: flex;
    justify-content: center;
  }

  .foot_container {
    display: flex;
    justify-content: right;
  }

  .head_image {
    width: 200px;
    height: auto;
  }
  .foot_image {
    width: 200px;
    height: auto;
  }
</style>
