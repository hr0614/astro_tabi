---
import FontAwesomeIcon from "../../layouts/FontAwesomeIcon.astro";
import {
  faSquareXTwitter,
  faInstagram,
  faSquareBluesky,
} from "@fortawesome/free-brands-svg-icons";
---

<div class="mobile-menu-overlay">
  <div class="mobile-menu-container">
    <div class="menu-header">
      <div class="menu-title">menu</div>
      <button class="close-button" id="menu-close-button">
        <span class="close-icon">✕</span>
      </button>
    </div>
    <nav class="mobile-nav">
      <ul class="menu-items">
        <li class="menu-item">
          <a href="/#illust-section" class="menu-link illust anchor-link"
            >Illust</a
          >
        </li>
        <li class="menu-item">
          <a href="/#work-section" class="menu-link anchor-link">Work</a>
        </li>
        <li class="menu-item">
          <a href="/#info-section" class="menu-link anchor-link">Info</a>
        </li>
        <li class="menu-item">
          <a href="/#profile-section" class="menu-link anchor-link">Profile</a>
        </li>
        <li class="menu-item">
          <a href="/#contact-section" class="menu-link anchor-link">Contact</a>
        </li>
      </ul>
    </nav>
    <div class="social-links">
      <a
        href="https://www.instagram.com/tabi_0v0/"
        target="_blank"
        class="social-link"
      >
        <FontAwesomeIcon icon={faInstagram} />
      </a>
      <a href="https://x.com/tabi_0v0" target="_blank" class="social-link">
        <FontAwesomeIcon icon={faSquareXTwitter} />
      </a>
      <a
        class="social-link"
        href="https://bsky.app/profile/tabi-0v0.bsky.social"
        target="_blank"><FontAwesomeIcon icon={faSquareBluesky} /></a
      >
    </div>
  </div>
</div>

<script>
  // メニューのリンククリックとクローズを初期化する関数
  function initMenuLinks() {
    // モバイルメニューコンテナを取得
    const menuContainer = document.querySelector(".mobile-menu-container");

    // メニューコンテナ全体のクリックを監視
    menuContainer?.addEventListener("click", (e) => {
      const target = e.target as HTMLElement;

      // クリックされた要素またはその親要素がアンカーリンクかどうかを確認
      const link = target.closest(".anchor-link") as HTMLAnchorElement | null;

      if (link) {
        // リンクがクリックされた場合はデフォルト動作を防止
        e.preventDefault();

        // メニューを閉じる
        const menuOverlay = document.querySelector(".mobile-menu-overlay");
        menuOverlay?.classList.remove("active");
        document.body.style.overflow = "";

        // リンク先が/#で始まる場合（ページ内リンク）
        const href = link.getAttribute("href") || "";
        if (href.startsWith("/#")) {
          // ハッシュ部分を抽出
          const hash = href.substring(href.indexOf("#"));
          const targetId = hash.substring(1);

          // ターゲット要素を取得
          const targetElement = document.getElementById(targetId);

          // ターゲット要素が存在する場合、少し遅延してからスクロール
          if (targetElement) {
            setTimeout(() => {
              window.location.href = href; // URLのハッシュを更新

              // スクロール位置計算
              const rect = targetElement.getBoundingClientRect();
              const offsetPosition = rect.top + window.scrollY;

              // スムーズスクロール
              window.scrollTo({
                top: offsetPosition,
                behavior: "smooth",
              });
            }, 200); // メニューが閉じるのを待つ
          }
        }
      }
    });
  }

  // 通常のページ読み込み時
  document.addEventListener("DOMContentLoaded", initMenuLinks);

  // Astroのビュートランジション後
  document.addEventListener("astro:page-load", initMenuLinks);

  // Astroのページスワップ後も実行（確実に初期化するため）
  document.addEventListener("astro:after-swap", () => {
    // 少し遅延させて実行（DOMの更新を待つ）
    setTimeout(initMenuLinks, 100);
  });
</script>

<style>
  .mobile-menu-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.5);
    z-index: 999;
    display: none;
  }

  .mobile-menu-overlay.active {
    display: block;
  }

  .mobile-menu-container {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) scale(0.9);
    opacity: 0;
    width: 80%;
    max-width: 320px;
    height: auto;
    max-height: 90dvh;
    background-color: rgba(255, 255, 255, 0.95);
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
    padding: 30px 20px;
    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.2);
    border-radius: 20px;
    overflow-y: auto;
  }

  .mobile-menu-overlay.active .mobile-menu-container {
    transform: translate(-50%, -50%) scale(1);
    opacity: 1;
  }

  .menu-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
    /* border-bottom: 1px dotted #ccc; */
  }

  .menu-title {
    font-family: "Playwrite NZ";
    font-size: 34px;
    color: #1d2027;
    /* font-style: italic; */
    text-decoration: underline dotted;
    text-underline-offset: 5px;
    margin: 0 auto;
  }

  .close-button {
    position: absolute;
    top: 20px;
    right: 20px;
    background: none;
    border: none;
    cursor: pointer;
    font-size: 24px;
    color: #5fd3c6;
    padding: 5px;
    z-index: 10;
  }

  .mobile-nav {
    flex: 1;
    margin: 10px 0 30px 0;
  }

  .menu-items {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .menu-item {
    text-align: center;
  }

  .menu-link {
    display: inline-block;
    font-family: "Rowdies Regular";
    font-size: 24px;
    color: #1d2027;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .social-links {
    display: flex;
    justify-content: center;
    gap: 20px;
    margin-top: auto;
    margin-bottom: 20px;
  }

  .social-link {
    font-size: 40px;
    color: #5fd3c6;
    /* transition: all 0.2s ease; */
  }

  /* スクロールバーのスタイリング */
  .mobile-menu-container::-webkit-scrollbar {
    width: 5px;
  }

  .mobile-menu-container::-webkit-scrollbar-track {
    background: rgba(0, 0, 0, 0.05);
    border-radius: 10px;
  }

  .mobile-menu-container::-webkit-scrollbar-thumb {
    background: rgba(95, 211, 198, 0.5);
    border-radius: 10px;
  }
</style>
