---
import { Image } from "astro:assets";
import accentTop from "../img/menu/02.png";
import accentBottom from "../img/menu/01.png";
---

<div class="menu_wrapper">
  <div class="title_text">tabi :)<br />Illustration</div>
  <div class="menu_list">
    <ul>
      <li class="menu_title">Info</li>
      <li class="menu_title">Profile</li>
      <li class="menu_title">Illust</li>
      <li class="menu_title">Work</li>
      <li class="menu_title">Contact</li>
    </ul>
    <Image src={accentTop} class="accent-top" alt="" />
    <Image src={accentBottom} class="accent-bottom" alt="" />
  </div>
  <div class="social_items">
    <i class="fa-brands fa-instagram social_icon"></i>
    <i class="fa-brands fa-x-twitter social_icon"></i>
  </div>
</div>

<style>
  .menu_wrapper {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }

  .title_text {
    font-family: "Playwrite NZ", serif;
    font-weight: 200;
    font-style: normal;
    font-size: min(5vw, 45px);
    letter-spacing: 0px;
    line-height: min(5vw, 50px);
    width: 100%;
    text-align: center;
    /* margin: 10px 20px; */
    color: white;
  }

  .menu_list {
    position: relative;
    margin-top: 10vh;
    width: 17vw;
    background-color: #ededed;
    padding: 44px 0;
    border-radius: 25px;
  }
  .menu_title {
    font-family: "Rowdies Regular", serif;
    font-weight: 400;
    font-style: normal;
    font-size: min(2.5vw, 25px);
    letter-spacing: 0.1vw;
    color: #1d2027;
    text-align: center;
    line-height: min(3.5vw, 30px);
    padding: 5px 0px;
  }

  .menu_title:hover {
    background-color: #5fd3c6;
    color: #ffffff;
  }

  .accent-top {
    position: absolute;
    top: 0px;
    left: -90px;
    width: 12vw;
    min-width: 170px;
    height: auto;
  }
  .accent-bottom {
    position: absolute;
    bottom: -4px;
    right: -75px;
    width: 10vw;
    min-width: 140px;
    height: auto;
  }

  .social_items {
    margin-top: 16px;
  }
  .social_icon {
    font-size: 40px;
    color: #5fd3c6;
  }

  .social_icon:hover {
    opacity: 0.5;
  }
</style>
