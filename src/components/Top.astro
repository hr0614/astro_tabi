---
import Menu from "../components/Menu.astro";
import { Loading } from "./loading/Loading.tsx";
import { Image } from "astro:assets";
import mainImage from "../img/main_image.jpg";
import loopImage from "../img/wave.png";
---

<div class="wrapper">
  <!-- <Loading client:load /> -->
  <Image class="main_image" src={mainImage} alt="" />
  <div class="loop_area">
    <div class="loop_down">
      <Image src={loopImage} alt="" />
    </div>
    <div class="loop_down">
      <Image src={loopImage} alt="" />
    </div>
    <div class="loop_down">
      <Image src={loopImage} alt="" />
    </div>
    <div class="loop_down">
      <Image src={loopImage} alt="" />
    </div>
    <div class="loop_down">
      <Image src={loopImage} alt="" />
    </div>
    <div class="loop_down">
      <Image src={loopImage} alt="" />
    </div>
  </div>
  <div class="menu_area">
    <Menu />
  </div>
</div>

<style>
  .main_image {
    width: 70%;
    height: auto;
  }
  .wrapper {
    position: relative;
    overflow: hidden;
    height: 100vh;
    background-color: #1d2027;
  }

  .loop_area {
    flex-flow: column;
    position: absolute;
    z-index: 1;
    top: 0px;
  }

  .menu_area {
    position: absolute;
    z-index: 10;
    top: 10vh;
    right: 2vw;
    width: 30%;
  }

  @keyframes loop_animation_down {
    0% {
      transform: translateY(-100%);
    }
    100% {
      transform: translateY(0);
    }
  }

  .loop_down {
    animation: loop_animation_down 7s linear infinite;
    width: 100%;
    margin-bottom: -1px;
  }
</style>
