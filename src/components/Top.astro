---
import Menu from "../components/Menu.astro";
import { Loading } from "./loading/Loading.tsx";
import { Image } from "astro:assets";
import mainImage from "../img/main_image.jpg";
---

<div class="wrapper">
  <!-- <Loading client:load /> -->
  <Image class="main_image" src={mainImage} alt="" />
  <div class="menu_area">
    <Menu />
  </div>
</div>

<style>
  .main_image {
    width: 60%;
    height: auto;
  }

  @media screen and (min-width: 840px) and (max-width: 920px) {
    .main_image {
      width: auto;
      height: 100%;
    }
  }

  @media screen and (max-width: 839px) {
    .main_image {
      width: auto;
      height: 100vh;
      object-fit: cover;
    }

    .menu_area {
      display: none;
    }
  }

  .wrapper {
    position: relative;
    overflow: hidden;
    height: 100vh;
    background-color: #1d2027;
  }

  .menu_area {
    position: absolute;
    z-index: 10;
    top: 10vh;
    right: 3vw;
    width: 30%;
  }
</style>
