---
import { Image } from "astro:assets";
import top from "../../img/background/08.png";
import bottom from "../../img/background/09.png";
---

<div class="background">
  <Image src={top} alt="" class="top-img" />
  <Image src={bottom} alt="" class="bottom-img" />
</div>

<style>
  .background {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }

  .top-img {
    position: absolute;
    top: 140px;
    left: 160px;
    width: 400px;
    height: auto;
    opacity: 0.5;
  }

  .bottom-img {
    position: absolute;
    bottom: 50px;
    right: 120px;
    width: 300px;
    height: auto;
    opacity: 0.5;
  }
</style>
