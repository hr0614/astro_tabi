---
import Layout from "../layouts/Layout.astro";
import Section from "../components/partial/topContents/Section.astro";
import Illust from "../components/partial/topContents/Illust.astro";
import Profile from "../components/partial/topContents/Profile.astro";
import Work from "../components/partial/topContents/Work.astro";
import Info from "../components/partial/topContents/Info.astro";
import Contact from "../components/partial/topContents/Contact.astro";
import Top from "../components/partial/topContents/Top.astro";
import ProfileBg from "../components/UIcontent/background/ProfileBg.astro";
import ContactBg from "../components/UIcontent/background/ContactBg.astro";
import illustHeadImage from "../img/HeadImage/Illust.png";
import infoHeadImage from "../img/HeadImage/Info.png";
import profileHeadImage from "../img/HeadImage/Profile.png";
import workHeadImage from "../img/HeadImage/Work.png";
import contactHeadImage from "../img/HeadImage/Contact.png";
import footImage from "../img/footImage/ViewMore_A.png";
---

<Layout title="tabi:) Illustration">
  <div class="container">
    <!-- TOPページ -->
    <Section color="gray" rounded={false} isTop={true}><Top /></Section>

    <!-- Infoセクション -->
    <Section
      color="#DADEDD"
      height="100dvh"
      headImage={infoHeadImage}
      footImage={footImage}
      link="/info"
      id="info-section"
    >
      <ProfileBg slot="background" />
      <Info />
    </Section>

    <!-- Illustセクション -->
    <Section
      color="#DADEDD"
      height="100dvh"
      headImage={illustHeadImage}
      footImage={footImage}
      link="/gallery"
      id="illust-section"
    >
      <ContactBg slot="background" />
      <Illust />
    </Section>

    <!-- Workセクション -->
    <Section
      color="#DADEDD"
      height="100dvh"
      headImage={workHeadImage}
      footImage={footImage}
      link="/works"
      id="work-section"
    >
      <ContactBg slot="background" />
      <Work />
    </Section>

    <!-- Profileセクション -->
    <Section
      color="#DADEDD"
      height="100dvh"
      headImage={profileHeadImage}
      id="profile-section"
    >
      <ProfileBg slot="background" />
      <Profile />
    </Section>
    <!-- Contactセクション -->
    <Section
      color="#DADEDD"
      height="100dvh"
      headImage={contactHeadImage}
      id="contact-section"
    >
      <ContactBg slot="background" />
      <Contact />
    </Section>
  </div>
</Layout>

<style>
  .container {
    overflow: auto;
    scroll-snap-type: y mandatory;
    height: 100dvh;
    background-color: color= "#DADEDD";
  }
</style>
