---
import Layout from "../layouts/Layout.astro";
import Section from "../components/Section.astro";
import Illust from "../components/Illust.astro";
import Profile from "../components/Profile.astro";
import Work from "../components/Work.astro";
import Info from "../components/Info.astro";
import Contact from "../components/Contact.astro";
import Top from "../components/Top.astro";
import illustHeadImage from "../img/HeadImage/Illust.png";
import infoHeadImage from "../img/HeadImage/Info.png";
import profileHeadImage from "../img/HeadImage/Profile.png";
import workHeadImage from "../img/HeadImage/Work.png";
import contactHeadImage from "../img/HeadImage/Contact.png";
import footImage from "../img/footImage/ViewMore_A.png";
---

<Layout title="tabi:) Illustration">
  <div class="container">
    <Section color="gray" rounded={false}><Top /></Section>
    <Section color="#DADEDD" headImage={illustHeadImage} footImage={footImage}
      ><Illust /></Section
    >
    <Section color="#DADEDD" headImage={infoHeadImage} footImage={footImage}
      ><Info /></Section
    >
    <Section color="#DADEDD" headImage={profileHeadImage}><Profile /></Section>
    <Section color="#DADEDD" headImage={workHeadImage} footImage={footImage}
      ><Work /></Section
    >
    <Section color="#DADEDD" headImage={contactHeadImage}><Contact /></Section>
  </div>
</Layout>

<style>
  .container {
    overflow: auto;
    scroll-snap-type: y mandatory;
    height: 100vh;
  }
</style>
