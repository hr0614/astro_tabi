---
import Layout from "../layouts/Layout.astro";
import Section from "../components/Section.astro";
import Illust from "../components/Illust.astro";
import Profile from "../components/Profile.astro";
import Work from "../components/Work.astro";
import Info from "../components/Info.astro";
import Contact from "../components/Contact.astro";
import Top from "../components/Top.astro";
---

<Layout title="tabi:) Illustration">
  <div class="container">
    <Section color="gray"><Top /></Section>
    <Section color="yellow"><Info /></Section>
    <Section color="blue"><Profile /></Section>
    <Section color="red"><Illust /></Section>
    <Section color="green"><Work /></Section>
    <Section color="pink"><Contact /></Section>
  </div>
</Layout>

<style>
  .container {
    overflow: auto;
    scroll-snap-type: y mandatory;
    height: 100vh;
  }
</style>
