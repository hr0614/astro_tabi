---
import Layout from "../layouts/Layout.astro";
import Section from "../components/Section.astro";
import Illust from "../components/Illust.astro";
import Profile from "../components/Profile.astro";
import Work from "../components/Work.astro";
import Info from "../components/Info.astro";
import Contact from "../components/Contact.astro";
import Top from "../components/Top.astro";
import ProfileBg from "../components/background/ProfileBg.astro";
import ContactBg from "../components/background/ContactBg.astro";
import BgTypeA from "../components/background/BgTypeA.astro";
import illustHeadImage from "../img/HeadImage/Illust.png";
import infoHeadImage from "../img/HeadImage/Info.png";
import profileHeadImage from "../img/HeadImage/Profile.png";
import workHeadImage from "../img/HeadImage/Work.png";
import contactHeadImage from "../img/HeadImage/Contact.png";
import footImage from "../img/footImage/ViewMore_A.png";
---

<Layout title="tabi:) Illustration">
  <div class="container">
    <Section color="gray" rounded={false} isTop={true}><Top /></Section>
    <Section
      color="#DADEDD"
      height="600px"
      headImage={illustHeadImage}
      footImage={footImage}
    >
      <!-- <IllustBg slot="background" /> -->
      <ContactBg slot="background" />
      <Illust />
    </Section>
    <Section
      color="#DADEDD"
      height="600px"
      headImage={infoHeadImage}
      footImage={footImage}
    >
      <ProfileBg slot="background" />
      <Info />
    </Section>

    <Section
      color="#DADEDD"
      height="600px"
      headImage={workHeadImage}
      footImage={footImage}
    >
      <ContactBg slot="background" />
      <Work />
    </Section>

    <Section color="#DADEDD" height="600px" headImage={profileHeadImage}>
      <ProfileBg slot="background" />
      <Profile />
    </Section>

    <Section color="#DADEDD" height="600px" headImage={contactHeadImage}>
      <ContactBg slot="background" />
      <Contact />
    </Section>
  </div>
</Layout>

<style>
  .container {
    overflow: auto;
    scroll-snap-type: y mandatory;
    height: 100vh;
    background-color: color= "#DADEDD";
  }
</style>
