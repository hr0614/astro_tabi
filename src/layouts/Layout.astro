---
import "../styles/reset.css";
import "../styles/fonts.css";
// import "../styles/global.css";
import { ViewTransitions } from "astro:transitions";
import "@fortawesome/fontawesome-svg-core/styles.css";
import Header from "../components/navigation/Header.astro";

interface Props {
	title: string;
	defaultTransition?: string; // ページのデフォルトトランジション
}

const { title, defaultTransition = "fade" } = Astro.props;
---

<!doctype html>
<html lang="en" data-default-transition={defaultTransition}>
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Astro description" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/public/icon/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<ViewTransitions fallback="swap" />
		<link
			rel="stylesheet"
			href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
		/>

		<script>
			// 各ページで一度だけ実行される初期化スクリプト
			document.addEventListener(
				"astro:page-load",
				() => {
					// 現在のURLを保存
					let currentPath = window.location.pathname;
					// console.log("Page loaded. Current path:", currentPath);

					// 遷移用のフラグ（TOPページから遷移してきたかどうか）
					let cameFromTop = sessionStorage.getItem("cameFromTop") === "true";
					// console.log("Came from top page:", cameFromTop);

					// TOPページの場合、次の遷移先のためにフラグをセット
					if (currentPath === "/") {
						sessionStorage.setItem("cameFromTop", "true");
					} else {
						sessionStorage.setItem("cameFromTop", "false");
					}

					// Astroのビュートランジション完了後の処理
					document.addEventListener("astro:after-swap", () => {
						console.log(
							"View transition completed. New path:",
							window.location.pathname,
						);
						// トランジション関連のクラスをリセット
						document.documentElement.classList.remove("no-transitions");
					});

					// popstateイベントでブラウザの戻る/進むボタンを検出
					window.addEventListener("popstate", (event) => {
						console.log(
							"Browser back/forward detected, current path:",
							currentPath,
						);

						// ブラウザバックでTOPページに戻る場合、ページをリロード
						if (currentPath !== "/" && window.location.pathname === "/") {
							console.log("Navigating back to top page, forcing reload");
							// 少し遅延させてリロード（ビュートランジションが完了するのを待つ）
							setTimeout(() => {
								window.location.reload();
							}, 100);
						}

						// 現在のパスを更新
						currentPath = window.location.pathname;
					});

					// TOPページからの遷移後で、かつGalleryページ等の場合の特別な処理
					if (cameFromTop && currentPath !== "/") {
						console.log(
							"This page was loaded from the top page, applying special handling if needed",
						);
						// 必要に応じて特別な処理を追加（例：特定のスクリプトの初期化など）
					}
				},
				{ once: true },
			);

			// ビュートランジション開始前の処理
			document.addEventListener("astro:before-preparation", (event) => {
				// クリックされたリンク要素を取得
				const link = event.target as HTMLAnchorElement;
				// トップページから他のページへのリンククリック時の特別処理
				if (
					window.location.pathname === "/" &&
					link &&
					link.getAttribute("href") !== "/"
				) {
					console.log(
						"Navigating from top page to:",
						link.getAttribute("href"),
					);
					// TOPページからの遷移を記録
					sessionStorage.setItem("cameFromTop", "true");
				}
			});

			// ビュートランジション準備完了時の処理
			document.addEventListener("astro:after-preparation", () => {
				console.log("View transition preparation completed");
			});

			// ページ読み込み時の処理
			document.addEventListener("DOMContentLoaded", () => {
				const currentPath = window.location.pathname;
				// console.log("Page loaded. Current path:", currentPath);

				// TOP ページからの遷移かどうかを確認
				const cameFromTop = sessionStorage.getItem("cameFromTop") === "true";
				// console.log("Came from top page:", cameFromTop);

				// 前後移動のためのイベントリスナー設定
				initPageTransitions();
			});

			// ページトランジションの初期化
			function initPageTransitions() {
				// 戻る・進むボタンのイベントをリッスン
				window.addEventListener("popstate", (event) => {
					// console.log(
					//   "Navigation popstate event detected",
					//   window.location.pathname,
					// );

					// TOP ページに戻った場合
					if (window.location.pathname === "/") {
						// console.log(
						//   "Navigated back to home page",
						//   window.location.pathname,
						// );

						// TOP ページから別のページへ移動した後に戻ってきた場合は強制リロード
						if (
							document.referrer &&
							document.referrer.includes(window.location.host)
						) {
							// console.log("Navigating back to top page, forcing reload");
							window.location.reload();
						}
					}
				});

				// Astro View Transitions が終了した後の処理
				document.addEventListener("astro:page-load", () => {
					// スクロール位置をリセット
					window.scrollTo(0, 0);

					// モバイルメニューをクローズ
					const menuOverlay = document.querySelector(".mobile-menu-overlay");
					if (menuOverlay) {
						// console.log(
						//   "Navigation complete, closing mobile menu if open"
						// );
						menuOverlay.classList.remove("active");
						document.body.style.overflow = "";
					}

					// TOP ページからの遷移情報をクリア
					sessionStorage.removeItem("cameFromTop");
				});

				// ビュートランジション準備完了イベント
				document.addEventListener("astro:before-preparation", () => {
					// console.log(
					//   "View transition preparation started",
					//   window.location.pathname,
					// );
				});

				// ビュートランジション準備完了イベント
				document.addEventListener("astro:after-preparation", () => {
					// console.log("View transition preparation completed");
				});
			}
		</script>
	</head>
	<body>
		<Header />
		<main class="main-content">
			<slot />
		</main>
	</body>
</html>

<style is:global>
	/* トランジションのベーススタイル */
	::view-transition-old(root),
	::view-transition-new(root) {
		animation-duration: 0.5s;
		animation-timing-function: ease;
	}

	/* フェードトランジション（デフォルト） */
	html[data-default-transition="fade"] ::view-transition-old(root) {
		animation-name: fade-out;
	}

	html[data-default-transition="fade"] ::view-transition-new(root) {
		animation-name: fade-in;
	}

	/* メインコンテンツのスタイル
	.main-content {
		padding-top: 60px; ヘッダーの高さ分
	}

	/* スマートフォン用 */
	/* @media (max-width: 720px) {
		.main-content {
			padding-top: 50px;
		}
	} */

	/* スライドトランジション */
	html[data-default-transition="slide"] ::view-transition-old(root) {
		animation-name: slide-to-left;
	}

	html[data-default-transition="slide"] ::view-transition-new(root) {
		animation-name: slide-from-right;
	}

	/* ズームトランジション */
	html[data-default-transition="zoom"] ::view-transition-old(root) {
		animation-name: zoom-out;
	}

	html[data-default-transition="zoom"] ::view-transition-new(root) {
		animation-name: zoom-in;
	}

	/* ビュートランジションを完全に無効化 */
	html.no-transitions,
	html.no-transitions * {
		view-transition-name: none !important;
	}

	html.no-transitions::view-transition-group(*),
	html.no-transitions::view-transition-old(*),
	html.no-transitions::view-transition-new(*) {
		animation: none !important;
	}

	/* アニメーションの定義 */
	@keyframes fade-in {
		from {
			opacity: 0;
		}
		to {
			opacity: 1;
		}
	}

	@keyframes fade-out {
		from {
			opacity: 1;
		}
		to {
			opacity: 0;
		}
	}

	@keyframes slide-from-right {
		from {
			transform: translateX(100%);
		}
		to {
			transform: translateX(0);
		}
	}

	@keyframes slide-to-left {
		from {
			transform: translateX(0);
		}
		to {
			transform: translateX(-100%);
		}
	}

	@keyframes zoom-in {
		from {
			transform: scale(0.8);
			opacity: 0;
		}
		to {
			transform: scale(1);
			opacity: 1;
		}
	}

	@keyframes zoom-out {
		from {
			transform: scale(1);
			opacity: 1;
		}
		to {
			transform: scale(1.2);
			opacity: 0;
		}
	}
</style>
